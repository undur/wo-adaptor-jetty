<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>is.rebbi</groupId>
	<artifactId>wo-adaptor-jetty-reactor</artifactId>
	<version>0.12.2</version>
	<packaging>pom</packaging>
	<name>wo-adaptor-jetty reactor</name>

	<properties>
		<maven.compiler.release>25</maven.compiler.release>
		<jetty.version>12.1.13</jetty.version>
		<webobjects.version>5.4.3</webobjects.version>
		<junit.version>6.1.3</junit.version>
		<surefire.version>3.5.6</surefire.version>
	</properties>

	<!-- The modules share this reactor's version: a given version of wo-adaptor-jetty-push is built and tested against the same version of wo-adaptor-jetty -->
	<modules>
		<module>wo-adaptor-jetty</module>
		<module>wo-adaptor-jetty-push</module>
	</modules>

	<build>
		<plugins>
			<plugin>
				<groupId>is.rebbi</groupId>
				<artifactId>vermilingua-maven-plugin</artifactId>
				<version>1.1.10</version>
				<extensions>true</extensions>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${surefire.version}</version>
					<configuration>
						<!-- One fresh JVM per test class. The adaptor reads its configuration into static finals when it is
						     loaded, and WOApplication is a per-JVM singleton, so a class that tests a configuration has to
						     own the JVM it runs in. -->
						<forkCount>1</forkCount>
						<reuseForks>false</reuseForks>
						<systemPropertyVariables>
							<!-- WO reads ~/WebObjects.properties; point it at an empty home so the developer's settings
							     (a global WOAdaptor, say) can't change what the tests observe -->
							<user.home>${project.build.directory}/test-home</user.home>
						</systemPropertyVariables>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<version>${surefire.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.webobjects</groupId>
				<artifactId>JavaWebObjects</artifactId>
				<version>${webobjects.version}</version>
				<exclusions>
					<exclusion>
						<groupId>com.webobjects</groupId>
						<artifactId>JavaXML</artifactId>
					</exclusion>
				</exclusions>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-server</artifactId>
				<version>${jetty.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jetty.websocket</groupId>
				<artifactId>jetty-websocket-jetty-server</artifactId>
				<version>${jetty.version}</version>
			</dependency>

			<!-- Tests -->
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-engine</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-params</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>
			<!-- WOApplication's static initializer needs EOAccess, which pulls in log4j as it loads. The adaptor uses neither;
			     the test harness needs them only to construct a WOApplication. -->
			<dependency>
				<groupId>com.webobjects</groupId>
				<artifactId>JavaEOAccess</artifactId>
				<version>${webobjects.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>ch.qos.reload4j</groupId>
				<artifactId>reload4j</artifactId>
				<version>1.2.26</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>is.rebbi</groupId>
				<artifactId>wo-adaptor-jetty</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<distributionManagement>
		<repository>
			<id>wocommunity.deployment</id>
			<name>WOCommunity Maven2 Releases Repository</name>
			<url>https://maven.wocommunity.org/content/repositories/releases</url>
		</repository>
		<snapshotRepository>
			<id>wocommunity.deployment</id>
			<uniqueVersion>false</uniqueVersion>
			<name>WOCommunity Maven2 Snapshots Repository</name>
			<url>https://maven.wocommunity.org/content/repositories/snapshots/</url>
		</snapshotRepository>
	</distributionManagement>
</project>
